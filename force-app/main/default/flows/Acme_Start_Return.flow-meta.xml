<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Set_Not_Matched</name>
        <label>Set Not Matched</label>
        <locationX>50</locationX>
        <locationY>400</locationY>
        <assignmentItems>
            <assignToReference>eligible</assignToReference>
            <operator>Assign</operator>
            <value><booleanValue>false</booleanValue></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>message</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>We couldn't match that order to this customer, so no return was started.</stringValue></value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Not_Delivered</name>
        <label>Set Not Delivered</label>
        <locationX>250</locationX>
        <locationY>400</locationY>
        <assignmentItems>
            <assignToReference>eligible</assignToReference>
            <operator>Assign</operator>
            <value><booleanValue>false</booleanValue></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>message</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>This order hasn't been delivered yet. A return can be started once it arrives.</stringValue></value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Outside_Window</name>
        <label>Set Outside Window</label>
        <locationX>450</locationX>
        <locationY>400</locationY>
        <assignmentItems>
            <assignToReference>eligible</assignToReference>
            <operator>Assign</operator>
            <value><booleanValue>false</booleanValue></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>message</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>This order was delivered more than 30 days ago, which is outside the return window.</stringValue></value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Return_Started</name>
        <label>Set Return Started</label>
        <locationX>650</locationX>
        <locationY>700</locationY>
        <assignmentItems>
            <assignToReference>eligible</assignToReference>
            <operator>Assign</operator>
            <value><booleanValue>true</booleanValue></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>returnCaseNumber</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Get_Return_Case.CaseNumber</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>message</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>Return started. We will email a prepaid return label; refunds process within 3 business days of receiving the item.</stringValue></value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Eligibility</name>
        <label>Check Eligibility</label>
        <locationX>350</locationX>
        <locationY>250</locationY>
        <defaultConnector>
            <targetReference>Set_Not_Matched</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not matched</defaultConnectorLabel>
        <rules>
            <name>Is_Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>emailMatches</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Order.Fulfillment_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>Delivered</stringValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>withinWindow</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Return_Case</targetReference>
            </connector>
            <label>Eligible</label>
        </rules>
        <rules>
            <name>Not_Delivered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>emailMatches</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Order.Fulfillment_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue><stringValue>Delivered</stringValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Not_Delivered</targetReference>
            </connector>
            <label>Not delivered</label>
        </rules>
        <rules>
            <name>Outside_Window</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>emailMatches</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Outside_Window</targetReference>
            </connector>
            <label>Outside window</label>
        </rules>
    </decisions>
    <description>Agent action: start a return for a verified customer's order. Enforces the returns policy (delivered, within 30 days of delivery) and opens a Return case. Admin-maintainable: change the window in the withinWindow formula.</description>
    <formulas>
        <name>emailMatches</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!Get_Order.Id})) &amp;&amp; LOWER({!Get_Order.BillToContact.Email}) = LOWER(TRIM({!customerEmail}))</expression>
    </formulas>
    <formulas>
        <name>withinWindow</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!Get_Order.Estimated_Delivery__c})) &amp;&amp; {!Get_Order.Estimated_Delivery__c} &gt;= TODAY() - 30</expression>
    </formulas>
    <formulas>
        <name>caseSubject</name>
        <dataType>String</dataType>
        <expression>LEFT(&quot;Return: &quot; &amp; {!Get_Order.External_Order_Number__c} &amp; &quot; - &quot; &amp; {!reason}, 255)</expression>
    </formulas>
    <interviewLabel>Acme Start Return {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Acme Start Return</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Return_Case</name>
        <label>Create Return Case</label>
        <locationX>650</locationX>
        <locationY>400</locationY>
        <connector>
            <targetReference>Get_Return_Case</targetReference>
        </connector>
        <inputAssignments>
            <field>Subject</field>
            <value><elementReference>caseSubject</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value><elementReference>reason</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>ContactId</field>
            <value><elementReference>Get_Order.BillToContactId</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Order__c</field>
            <value><elementReference>Get_Order.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Origin</field>
            <value><stringValue>Web</stringValue></value>
        </inputAssignments>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Order</name>
        <label>Get Order</label>
        <locationX>350</locationX>
        <locationY>100</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Eligibility</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>External_Order_Number__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>orderNumber</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Order</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Return_Case</name>
        <label>Get Return Case</label>
        <locationX>650</locationX>
        <locationY>550</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Return_Started</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>Create_Return_Case</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>CaseNumber</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>350</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Order</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>orderNumber</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>customerEmail</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>reason</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>eligible</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value><booleanValue>false</booleanValue></value>
    </variables>
    <variables>
        <name>message</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>returnCaseNumber</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
